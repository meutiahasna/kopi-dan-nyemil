<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/button_save_prof"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tv_prof_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Halo Nama,"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Profile Saya"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Profile Setting" />

        <EditText
            android:id="@+id/et_prof_nama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:hint="nama"
            android:inputType="textPersonName"
            android:background="@drawable/bg_edittext_outline"
            android:padding="14dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/button_save_prof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottom_nav_bar_prof"
        android:orientation="vertical">

        <Button
            android:id="@+id/btn_prof_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_nav_bar_prof"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nav_prof_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Home"
            android:layout_margin="12dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/nav_prof_order"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Order"
            android:layout_margin="12dp"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/nav_prof_profile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Profile"
            android:layout_margin="12dp"/>
    </LinearLayout>
</RelativeLayout>